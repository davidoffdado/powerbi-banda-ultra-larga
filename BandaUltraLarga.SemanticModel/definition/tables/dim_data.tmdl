	partition dim_data = m
		mode: import
		source =
				let
				    Origine = Csv.Document(File.Contents(CartellaDati & "dim_data.csv"), [Delimiter=",", Columns=7, Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Intestazioni = Table.PromoteHeaders(Origine, [PromoteAllScalars=true]),
				    Tipi = Table.TransformColumnTypes(Intestazioni, {{"data", type date}, {"anno", Int64.Type}, {"mese", Int64.Type}, {"periodo", type text}, {"ordine", Int64.Type}, {"rilevazione_fasi", type logical}, {"fine_anno", type logical}}, "en-US")
				in
				    Tipi

